# Bootstrap configuration for Linux Admin.
# Copy to .env on each host:  cp .env.example .env
# Or leave incomplete and use the first-run Setup Wizard in the browser.

# development | production
LNXADMIN_ENV=development

# false = show Setup Wizard on first open; true = already configured
LNXADMIN_SETUP_COMPLETE=false

# Listen address — prefer 127.0.0.1 behind a reverse proxy/VPN
LNXADMIN_BIND_HOST=127.0.0.1
LNXADMIN_BIND_PORT=8000

# Database (wizard / Settings → Connection can set these)
LNXADMIN_DB_HOST=localhost
LNXADMIN_DB_PORT=5432
LNXADMIN_DB_USER=lnxadmin
LNXADMIN_DB_PASSWORD=change-me
LNXADMIN_DB_NAME=lnxadmin

# Auth — openssl rand -hex 32  (auto-generated by wizard if empty/weak)
LNXADMIN_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
LNXADMIN_JWT_EXPIRE_MINUTES=480
LNXADMIN_ADMIN_USER=admin
LNXADMIN_ADMIN_PASSWORD=change-me-strong-password

# CORS origins (comma-separated)
LNXADMIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:8000

LNXADMIN_METRICS_INTERVAL=1.5
LNXADMIN_HISTORY_INTERVAL=15
LNXADMIN_RETENTION_DAYS=30
