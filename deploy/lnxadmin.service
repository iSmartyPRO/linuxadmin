[Unit]
Description=Linux Admin panel
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=@ROOT@/src/backend
# No EnvironmentFile: the app reads @ROOT@/.env itself. Loading it here would
# turn the values into environment variables, which take precedence over the
# file, so changes made by the setup wizard / Settings would be ignored.
Environment=PYTHONPATH=.
Environment=LNXADMIN_ENV=production
ExecStart=@ROOT@/src/backend/.venv/bin/uvicorn app.main:app \
  --host @BIND_HOST@ \
  --port @BIND_PORT@ \
  --workers 1 \
  --proxy-headers \
  --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
# Hardening. The panel manages the host as root (nginx/wireguard configs in
# /etc, packages, users and their ~/.ssh), so ProtectSystem/ProtectHome would
# make those modules fail with read-only filesystem errors.
NoNewPrivileges=true
PrivateTmp=true
# Uncomment if the service user must run passwordless sudo for mutations:
# SupplementaryGroups=sudo

[Install]
WantedBy=multi-user.target
